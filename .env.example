# Configuração do Firebase para Sincronização entre Dispositivos
# Obtenha estas credenciais gratuitamente em https://console.firebase.google.com
# 1. Crie um projeto no Firebase
# 2. Ative Authentication -> Provedor "E-mail/senha"
# 3. Ative Firestore Database
# 4. Cole as chaves abaixo ou cole diretamente na interface web do DMS MTG Manager!

VITE_FIREBASE_API_KEY=sua-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
VITE_FIREBASE_APP_ID=seu-app-id

